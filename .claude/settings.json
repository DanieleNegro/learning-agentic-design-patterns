{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-force-push.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__memory__delete_.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Deleting from the memory graph is disabled' >&2; exit 2"
          }
        ]
      }
    ]
  }
}
